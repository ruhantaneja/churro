# Environment files (never commit real keys)
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime session data
sessions/

# OS junk
.DS_Store
Thumbs.db

