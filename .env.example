# CHURRO OpenAI configuration.
#
# Copy this file and replace the placeholder with your real key. NEVER
# commit a real API key. The key is read from the environment variable
# OPENAI_API_KEY; CHURRO is never given the key in code.

OPENAI_API_KEY=sk-your-key-here

# Optional: CHURRO Ollama configuration.
#
# The Ollama provider talks to a local Ollama server's OpenAI-compatible
# endpoint over plain HTTP; no API key is needed. Set OLLAMA_MODEL to any
# model you have pulled locally with `ollama pull <model>`. OLLAMA_BASE_URL
# defaults to http://localhost:11434/v1 when unset.

OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1